# Copia a `.env.local` (desarrollo) o usa `.env.production` al hacer build.
#
# Origen API (sin /api/v1) — cookies Sanctum + CSRF
VUE_APP_API_ROOT=https://api.tbnliving.com
# Rutas v1 del miembro
VUE_APP_API_URL=https://api.tbnliving.com/api/v1
# Obligatorio en producción cross-subdomain (admin/front → api)
VUE_APP_API_WITH_CREDENTIALS=true

# Desarrollo Laragon (proxy vue.config.js)
# VUE_APP_API_ROOT=
# VUE_APP_API_URL=/api/v1
# VUE_APP_BACKEND_ORIGIN=http://127.0.0.1:8000
# VUE_APP_API_WITH_CREDENTIALS=true
